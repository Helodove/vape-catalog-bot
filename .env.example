TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
MOYSKLAD_TOKEN=your_moysklad_bearer_token_here
ADMIN_CHAT_ID=123456789
BOT_BASE_URL=https://your-bot.railway.app
MINIAPP_ORIGIN=https://thevaper-miniapp.vercel.app

# Supabase (картинки товаров, подписки сотрудников, аналитика)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_here

# Продуктовая аналитика
# Секрет для псевдонимизации пользователей: user_hash = HMAC-SHA256(telegram_user_id, ANALYTICS_SALT).
# Длинная случайная строка (например: python -c "import secrets; print(secrets.token_hex(32))").
# НЕ меняйте его в течение периода исследования — иначе пользователи «разорвутся» на два хэша.
ANALYTICS_SALT=
# Токен для GET /v1/analytics/summary (заголовок Authorization: Bearer <токен>)
ANALYTICS_ADMIN_TOKEN=
